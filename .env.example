# ShareTally configuration. Copy to your host's environment settings; nothing here is secret
# for the synthetic demo, but change every password before a public deployment.

# SQLite file. Created and seeded with synthetic data on first start.
SHARETALLY_DB=data/sharetally.db

# Demo clock: the engine evaluates records "as of" this date so results are reproducible.
# Leave empty to use the dataset date (2026-10-01).
SHARETALLY_AS_OF=

# Set to 1 when served over HTTPS (adds Secure cookies and HSTS).
SHARETALLY_SECURE_COOKIES=0

# Show the demo accounts table on the sign-in page (1/0).
SHARETALLY_SHOW_DEMO_LOGINS=1

# Demo account passwords (synthetic prototype only).
SHARETALLY_PW_REVIEWER=review-demo-2026
SHARETALLY_PW_CLERK=clerk-demo-2026
SHARETALLY_PW_AUDITOR=audit-demo-2026

# Password hashing cost (PBKDF2-SHA256 iterations).
SHARETALLY_PBKDF2_ITERATIONS=600000

# Optional AI assist. Without ANTHROPIC_API_KEY the app uses templates and a rule-based reader.
SHARETALLY_AI=1
SHARETALLY_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=   (set in the host's secret settings, never commit it)
